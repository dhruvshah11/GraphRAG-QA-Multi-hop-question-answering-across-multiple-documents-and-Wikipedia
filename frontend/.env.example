# Base URL of the GraphRAG-QA FastAPI backend.
# Leave empty to use the Vite dev-server proxy (/api -> VITE_PROXY_TARGET).
# Set it to call the backend directly, e.g. VITE_API_BASE=http://127.0.0.1:8000
# (the backend must then allow CORS from the frontend origin).
VITE_API_BASE=

# Target of the dev/preview server proxy for /api (default http://127.0.0.1:8000).
VITE_PROXY_TARGET=http://127.0.0.1:8000
