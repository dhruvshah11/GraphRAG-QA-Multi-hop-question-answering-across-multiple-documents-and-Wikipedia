# Copy to .env and adjust. Every setting is optional; defaults work offline after
# `python scripts/download_models.py`.

# ---- Open-domain (Wikipedia) mode ------------------------------------------
# Wikimedia's User-Agent policy requires contact details (URL or e-mail).
# Without them the API answers HTTP 403. Use YOUR OWN contact information:
# GRQA_WIKIPEDIA_USER_AGENT="GraphRAG-QA/1.0 (https://your-site.example; you@example.com)"

# ---- Runtime defaults (also editable on the Settings page) -----------------
# GRQA_CHUNK_SIZE=400
# GRQA_CHUNK_OVERLAP=80
# GRQA_TOP_K=8
# GRQA_MAX_HOPS=3
# GRQA_HYBRID_ALPHA=0.7
# GRQA_GENERATOR_BACKEND=auto        # auto | extractive | hf_reader | hf_generator | ollama | anthropic

# ---- Models ------------------------------------------------------------------
# GRQA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# GRQA_SPACY_MODEL=en_core_web_sm
# GRQA_HF_READER_MODEL=deepset/tinyroberta-squad2
# GRQA_HF_GENERATOR_MODEL=google/flan-t5-base
# GRQA_DEVICE=cpu                    # "cuda" if you have a GPU and a CUDA build of PyTorch

# ---- Optional LLM backends -------------------------------------------------
# Local LLM via Ollama (https://ollama.com), no API key needed:
# GRQA_OLLAMA_URL=http://localhost:11434
# GRQA_OLLAMA_MODEL=llama3.1:8b
# Claude API (official `anthropic` SDK: pip install anthropic). The SDK reads the key itself:
# ANTHROPIC_API_KEY=sk-ant-...
# GRQA_ANTHROPIC_MODEL=claude-opus-5-5
# GRQA_ANTHROPIC_EFFORT=medium

# ---- Misc ------------------------------------------------------------------------
# GRQA_MAX_UPLOAD_MB=25
# GRQA_LOG_LEVEL=INFO
